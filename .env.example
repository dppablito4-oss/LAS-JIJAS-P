APP_MODE=demo
# sol: GPT-6.1 Sol para visión y análisis. economy: Luna + DeepSeek.
AI_PROFILE=sol
APP_TIMEZONE=America/Lima
DATABASE_URL=sqlite:///data/app.db
OPENAI_API_KEY=
OPENAI_SINGLE_MODEL=gpt-6.1-sol
# Solo se utiliza en AI_PROFILE=economy.
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_ANALYSIS_EFFORT=medium
OPENAI_REVIEW_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
# Alternativa: deepseek-v4-pro. No se cambia automáticamente de modelo.
DEEPSEEK_REASONING_EFFORT=high
MAX_TOOL_ROUNDS=6
MAX_PARALLEL_TOOLS=3
MAX_OUTPUT_TOKENS=1800
MAX_ANALYSIS_SECONDS=120
MAX_IMAGE_BYTES=10485760
ODDS_PROVIDER=manual
MODEL_XI=0.0018
# USD por millón de tokens. Vacío: coste desconocido.
PRICE_DATE=
PRICE_MODEL=
INPUT_PRICE=
OUTPUT_PRICE=
