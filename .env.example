APP_MODE=demo
# sol: Sol para ambas tareas; economy: Luna+DeepSeek; hybrid: economy+revision Sol.
AI_PROFILE=sol
OPENAI_SINGLE_MODEL=gpt-6.1-sol
OPENAI_ANALYSIS_EFFORT=medium
OPENAI_ANALYSIS_MODE=standard
APP_TIMEZONE=America/Lima
DATABASE_URL=sqlite:///data/app.db
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_VISION_EFFORT=low
OPENAI_REVIEW_MODEL=gpt-6.1-sol
OPENAI_REVIEW_ENABLED=true
OPENAI_REVIEW_EFFORT=high
# standard o pro. Pro aumenta latencia y consumo; no requiere otro ID.
OPENAI_REVIEW_MODE=standard
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
MAX_TOOL_ROUNDS=6
MAX_PARALLEL_TOOLS=3
MAX_OUTPUT_TOKENS=8192
MAX_ANALYSIS_SECONDS=240
MODEL_TIMEOUT_SECONDS=45
AI_TIMEOUT_SECONDS=90
# Incluyen los tokens de razonamiento; no equivalen a un presupuesto monetario.
VISION_MAX_TOKENS=4096
REVIEW_MAX_TOKENS=8192
DEEPSEEK_MAX_TOKENS=8192
MAX_HISTORY_AGE_DAYS=30
MAX_QUOTE_AGE_HOURS=24
MAX_IMAGE_BYTES=10485760
ODDS_PROVIDER=manual
MODEL_XI=0.0018
# USD por millón de tokens. Vacío: coste desconocido.
PRICE_MODEL=
PRICE_DATE=
INPUT_PRICE=
OUTPUT_PRICE=
