APP_MODE=demo
# sol: Sol para visión/análisis; economy: Luna + DeepSeek; hybrid: añade revisión opcional.
AI_PROFILE=hybrid
APP_TIMEZONE=America/Lima
DATABASE_URL=sqlite:///data/app.db
OPENAI_API_KEY=
OPENAI_SINGLE_MODEL=gpt-6.1-sol
# Visión en economy/hybrid.
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_VISION_EFFORT=low
OPENAI_ANALYSIS_EFFORT=medium
OPENAI_REVIEW_MODEL=gpt-6.1-sol
# true añade una llamada OpenAI en modo real.
OPENAI_REVIEW_ENABLED=true
OPENAI_REVIEW_EFFORT=high
# reasoning.mode: standard o pro. EFFORT es independiente; no cambia el ID del modelo.
OPENAI_REVIEW_MODE=standard
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
# Alternativa para ahorro: deepseek-flash. Sin cambio automático de modelo.
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high
MAX_TOOL_ROUNDS=6
MAX_PARALLEL_TOOLS=3
MAX_OUTPUT_TOKENS=8192
MAX_ANALYSIS_SECONDS=240
# Plazo por llamada IA y para el ajuste estadístico.
MODEL_TIMEOUT_SECONDS=45
# Tiempo conjunto del analista y revisor; también plazo externo de extracción.
AI_TIMEOUT_SECONDS=90
# Incluyen razonamiento; no equivalen a un presupuesto monetario.
VISION_MAX_TOKENS=4096
REVIEW_MAX_TOKENS=8192
DEEPSEEK_MAX_TOKENS=8192
# Antigüedad del último resultado, no ventana de entrenamiento.
MAX_HISTORY_AGE_DAYS=30
MAX_QUOTE_AGE_HOURS=24
MAX_IMAGE_BYTES=10485760
ODDS_PROVIDER=manual
MODEL_XI=0.0018
# USD por millón de tokens. Vacío: coste desconocido.
PRICE_DATE=
PRICE_MODEL=
INPUT_PRICE=
OUTPUT_PRICE=
